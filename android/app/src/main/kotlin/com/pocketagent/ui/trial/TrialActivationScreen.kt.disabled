import com.pocketagent.ui.design.PaType

/**
 * 内测激活。
 *
 * ─────────────────────────────────────────────────────────────
 *  这一页要同时干三件事，缺一件用户就会来问
 * ─────────────────────────────────────────────────────────────
 *
 * 1. **说清"这里不用填 Key"** —— 老用户已经习惯去「API Key」页，
 *    不写明他会先去找 Key 输入框，找不到就来问"Key 在哪填"。
 * 2. **说清能用哪两个模型** —— 否则他会去选别的型号，然后收到一个
 *    400/404，而错误信息是厂商给的、看不懂。
 * 3. **说清"一码只能在这台手机上用一次"** —— 否则他会把码转发给同事，
 *    同事激活成功（我们拦不住，见文档），两边都以为占到了便宜。
 */
@Composable
fun TrialActivationScreen(
    viewModel: TrialActivationViewModel,
    onBack: (() -> Unit)? = null,
) {
    val state by viewModel.state.collectAsStateWithLifecycle()
    val status = state.status

    PaScreen(
        title = "内测激活",
        subtitle = "不用填自己的 Key，输入激活码就能用",
        onBack = onBack,
    ) {
        Column(
            modifier = Modifier
                .fillMaxWidth()
                .verticalScroll(rememberScrollState())
                .padding(horizontal = PaSpace.m),
            verticalArrangement = Arrangement.spacedBy(PaSpace.m),
        ) {
            // ── 当前状态 ──────────────────────────────────
            StatusCard(status = status, loading = state.loading)

            // ── 输入 ──────────────────────────────────────
            if (status !is TrialStatus.Active) {
                PaSectionTitle("输入激活码")
                PaTextField(
                    value = state.code,
                    onValueChange = viewModel::onCodeChange,
                    modifier = Modifier.fillMaxWidth(),
                    placeholder = "PA-XXXXXXXX-XXXXXXXX-XXXXXXXX-XXXXXXXX",
                    singleLine = true,
                    enabled = !state.busy,
                    isError = state.error != null,
                )
                Text(
                    text = "粘贴即可，大小写和中间的横线都不重要。",
                    style = PaType.caption,
                    modifier = Modifier.padding(top = PaSpace.xxs),
                )
                PaButton(
                    text = if (state.busy) "激活中…" else "激活",
                    onClick = viewModel::submit,
                    modifier = Modifier.fillMaxWidth(),
                    enabled = state.canSubmit,
                    fillWidth = true,
                )
            }

            state.error?.let {
                PaBanner(
                    title = "没能激活",
                    tone = PaBannerTone.Danger,
                    description = it,
                    modifier = Modifier.fillMaxWidth(),
                )
            }
            state.notice?.let {
                PaBanner(
                    title = "好了",
                    tone = PaBannerTone.Success,
                    description = it,
                    modifier = Modifier.fillMaxWidth(),
                )
            }

            // ── 说明 ──────────────────────────────────────
            PaSectionTitle("这次内测的规矩")
            PaBanner(
                title = "能用哪些模型",
                tone = PaBannerTone.Info,
                description = "内置 Key 只开了两个型号，别的选了会报错：",
                details = TrialCatalog.MODELS.map { "${it.displayName}（${it.id}）" },
                modifier = Modifier.fillMaxWidth(),
            )
            PaBanner(
                title = "一个码只能用一次",
                tone = PaBannerTone.Warning,
                description = "码是发给人、不是发给群的：它在「一台手机上只能用一次」，" +
                    "激活过就不能再激活（撤销也不行）。换手机需要重新要一个码。",
                modifier = Modifier.fillMaxWidth(),
            )
            PaBanner(
                title = "内测结束会请你删掉",
                tone = PaBannerTone.Info,
                description = "激活后本机会多一条叫「${TRIAL_LABEL_HINT}」的凭据，那是我们的 Key。" +
                    "内测结束后请到「API Key」页把它删掉，再换回自己的 Key。",
                modifier = Modifier.fillMaxWidth(),
            )

            // ── 撤销 ──────────────────────────────────────
            if (status is TrialStatus.Active) {
                PaSectionTitle("不玩了")
                PaButton(
                    text = "撤销本机激活",
                    onClick = viewModel::requestCancel,
                    modifier = Modifier.fillMaxWidth(),
                    style = PaButtonStyle.Danger,
                    enabled = !state.busy,
                )
                Text(
                    text = "撤销只影响这台手机，而且「当前这个码不会返还」 —— 要用得再要一个。",
                    style = PaType.caption,
                    modifier = Modifier.padding(top = PaSpace.xxs),
                )
            }
        }
    }

    if (state.confirmingCancel) {
        AlertDialog(
            onDismissRequest = viewModel::dismissCancel,
            title = { Text("撤销激活？") },
            text = {
                Text(
                    "撤销后内置 Key 会从这台手机删除，当前码也作废。" +
                        "如果你只是想换个 Key，去「API Key」页就行，不用撤销。",
                )
            },
            confirmButton = {
                TextButton(onClick = viewModel::confirmCancel) { Text("撤销") }
            },
            dismissButton = {
                TextButton(onClick = viewModel::dismissCancel) { Text("算了") }
            },
        )
    }
}

@Composable
private fun StatusCard(status: TrialStatus?, loading: Boolean) {
    val (title, badge, tone, detail) = when {
        loading -> StatusLine("正在读取…", null, PaBadgeTone.Neutral, null)
        status is TrialStatus.Active -> StatusLine(
            title = "已激活",
            badge = "可用",
            tone = PaBadgeTone.Success,
            detail = buildString {
                append("激活于 ")
                append(TrialAccessController.formatDay(status.state.activatedAtMillis))
                val left = status.remainingMillisAt
                if (left == null) {
                    append("，长期有效。")
                } else {
                    append("，还剩 ")
                    append(daysLeft(left))
                    append(" 天。")
                }
            },
        )
        status is TrialStatus.Expired -> StatusLine(
            title = "已过期",
            badge = "需要新码",
            tone = PaBadgeTone.Warning,
            detail = "内测资格已于 ${status.state.expiresAtMillis?.let(TrialAccessController::formatDay) ?: "—"} 到期。",
        )
        else -> StatusLine(
            title = "未激活",
            badge = null,
            tone = PaBadgeTone.Neutral,
            detail = "输入激活码后，这台手机就可以直接聊天、不用填自己的 Key。",
        )
    }

    Column(
        modifier = Modifier.fillMaxWidth(),
        verticalArrangement = Arrangement.spacedBy(PaSpace.xxs),
    ) {
        Row(verticalAlignment = Alignment.CenterVertically) {
            Text(
                text = title,
                style = PaType.title,
                fontWeight = FontWeight.SemiBold,
                modifier = Modifier.weight(1f),
            )
            if (badge != null) PaBadge(text = badge, tone = tone)
        }
        if (detail != null) {
            Text(text = detail, style = PaType.caption)
        }
    }
}

private data class StatusLine(
    val title: String,
    val badge: String?,
    val tone: PaBadgeTone,
    val detail: String?,
)

/** 剩余毫秒 → "还剩几天"。向上取整：剩 1 小时说"还剩 1 天"比说"还剩 0 天"诚实 */
private fun daysLeft(millis: Long): Long {
    if (millis <= 0L) return 0L
    val day = 86_400_000L
    return (millis + day - 1) / day
}

/**
 * 与 `AppContainer.TRIAL_CREDENTIAL_LABEL` 保持一致的展示用文案。
 *
 * ⚠️ 这里写死一份而不是引用 AppContainer：那一层在 app 模块里，
 *    而这个常量只在**说明文字**里出现一次，为了它引一个容器不值得。
 *    两处都写着同一句话，改一处时肉眼能对照 —— 见文档里的"3 处接线"。
 */
private const val TRIAL_LABEL_HINT = "内测（临时）"
